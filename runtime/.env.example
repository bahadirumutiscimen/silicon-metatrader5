# Copy to .env and adjust. Never commit .env.

# Docker context used by smt5 and the app. Empty = colima-x86 on macOS (the
# Güvenli mode's VM), the default context on Linux. Pinned per command, so
# other projects keep their own `docker context use`.
SMT5_DOCKER_CONTEXT=

# Runtime mode on macOS: empty = Güvenli (Colima x86_64 QEMU VM + container),
# mac-native = Mac yerel (MT5 in macOS Wine 11, runtime/macos/native.sh).
SMT5_PROVIDER=

# Image version: empty = the version of smt5 / the app; `edge` = latest main build.
SMT5_VERSION=

# noVNC desktop password (Güvenli mode / Linux). Strongly recommended.
SMT5_WEB_PASSWORD=

# Token for the mutating status API endpoints (data purge, restarts).
# Generate one with:  openssl rand -hex 24
# Empty = those endpoints are disabled.
SMT5_API_TOKEN=

# Container timezone (does not change the broker's server time)
TZ=Europe/Istanbul

# Bars per chart. Values above 100000 slow down history sync a lot under QEMU.
SMT5_MAXBARS=100000

# MT5 [Experts] at start: Algo Trading button + live trading by EAs (1/0),
# DLL imports for EAs (0 = MT5 default). Applied when the value changes.
SMT5_ALGO_TRADING=1
SMT5_DLL_IMPORT=0

# Each log in the container is kept under this size (MB); one rotated copy.
SMT5_LOG_MAX_MB=10

# Virtual screen size of the noVNC desktop.
SMT5_RESOLUTION=1366x768
# MT5's DPI in noVNC (Docker mode and headless Linux native) (96 = 100 %, 120 = 125 %, 72-288).
SMT5_DPI=96

# Host ports and bind address. Keep 127.0.0.1 unless you know why not.
SMT5_BIND=127.0.0.1
SMT5_DISPLAY_PORT=6081
SMT5_BRIDGE_PORT=8001
SMT5_STATUS_PORT=8002

# Unsupported: allow Rosetta / qemu-user translation (Wine usually crashes there).
SMT5_ALLOW_USER_EMULATION=0
